#prisma 4.0
def package "luce-browser-html" {
    str owner = "dymokomi"
    str version = "0.1.0"
    str kind = "package"
    str language = "luce-base"
    str description = "The HTML tokenizer and named character references from Ladybird's LibWeb, in luce-base."
    str readme = "README.md"

    def export "html_syntax" {
        str module = "luce_browser_html.html_syntax"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-std"
    }

    def dependency "luce-browser-foundation" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-browser-foundation"
    }
}
