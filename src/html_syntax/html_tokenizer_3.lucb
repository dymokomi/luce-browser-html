# mark: Quoted identifiers ======================================================================

# 13.2.5.59 DOCTYPE public identifier (double-quoted) state, https://html.spec.whatwg.org/multipage/parsing.html#doctype-public-identifier-(double-quoted)-state
func html_tokenizer_doctype_public_identifier_double_quoted_state(this: HtmlTokenizer*, current_input_character: u32?, stop_at_insertion_point: HtmlTokenizerStopAtInsertionPoint) -> TokenizerStep:
    if on(current_input_character, '"'):
        html_token_ensure_doctype_data(&this.m_current_token).public_identifier = html_tokenizer_consume_current_builder(this)
        return tokenizer_switch_to(this, .after_doctype_public_identifier)
    if on(current_input_character, 0):
        log_parse_error()
        ak.string_builder_append_code_point(&this.m_current_builder, 0xFFFD)
        return TokenizerStep.consume_next
    if on(current_input_character, '>'):
        log_parse_error()
        html_token_ensure_doctype_data(&this.m_current_token).public_identifier = html_tokenizer_consume_current_builder(this)
        html_token_ensure_doctype_data(&this.m_current_token).force_quirks = true
        return tokenizer_switch_to_and_emit_current_token(this, .data)
    if on_eof(current_input_character):
        log_parse_error()
        html_token_ensure_doctype_data(&this.m_current_token).force_quirks = true
        ak.queue_enqueue(&this.m_queued_tokens, html_tokenizer_move_current_token(this))
        return tokenizer_emit_eof(this)
    ak.string_builder_append_code_point(&this.m_current_builder, input_value(current_input_character))
    return TokenizerStep.consume_next

