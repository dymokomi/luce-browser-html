#==============================================================================================
#
#   html_tokenizer_3 - HTMLTokenizer states: DOCTYPE public and system identifiers
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp (lines 706-1136): the states
#       AfterDOCTYPEPublicKeyword to BogusDOCTYPE of next_token, one function each (see
#       html_tokenizer_1 for how the macros map to TokenizerStep).
#
#==============================================================================================

# mark: Keywords ================================================================================

# 13.2.5.57 After DOCTYPE public keyword state, https://html.spec.whatwg.org/multipage/parsing.html#after-doctype-public-keyword-state
func html_tokenizer_after_doctype_public_keyword_state(this: HtmlTokenizer*, current_input_character: u32?, stop_at_insertion_point: HtmlTokenizerStopAtInsertionPoint) -> TokenizerStep:
    if on_whitespace(current_input_character):
        return tokenizer_switch_to(this, .before_doctype_public_identifier)
    if on(current_input_character, '"'):
        log_parse_error()
        html_token_ensure_doctype_data(&this.m_current_token).missing_public_identifier = false
        return tokenizer_switch_to(this, .doctype_public_identifier_double_quoted)
    if on(current_input_character, '\''):
        log_parse_error()
        html_token_ensure_doctype_data(&this.m_current_token).missing_public_identifier = false
        return tokenizer_switch_to(this, .doctype_public_identifier_single_quoted)
    if on(current_input_character, '>'):
        log_parse_error()
        html_token_ensure_doctype_data(&this.m_current_token).force_quirks = true
        return tokenizer_switch_to_and_emit_current_token(this, .data)
    if on_eof(current_input_character):
        log_parse_error()
        html_token_ensure_doctype_data(&this.m_current_token).force_quirks = true
        ak.queue_enqueue(&this.m_queued_tokens, html_tokenizer_move_current_token(this))
        return tokenizer_emit_eof(this)
    log_parse_error()
    html_token_ensure_doctype_data(&this.m_current_token).force_quirks = true
    return tokenizer_reconsume_in(this, .bogus_doctype)

# 13.2.5.63 After DOCTYPE system keyword state, https://html.spec.whatwg.org/multipage/parsing.html#after-doctype-system-keyword-state
func html_tokenizer_after_doctype_system_keyword_state(this: HtmlTokenizer*, current_input_character: u32?, stop_at_insertion_point: HtmlTokenizerStopAtInsertionPoint) -> TokenizerStep:
    if on_whitespace(current_input_character):
        return tokenizer_switch_to(this, .before_doctype_system_identifier)
    if on(current_input_character, '"'):
        log_parse_error()
        html_token_ensure_doctype_data(&this.m_current_token).system_identifier = ak.string_new()
        html_token_ensure_doctype_data(&this.m_current_token).missing_system_identifier = false
        return tokenizer_switch_to(this, .doctype_system_identifier_double_quoted)
    if on(current_input_character, '\''):
        log_parse_error()
        html_token_ensure_doctype_data(&this.m_current_token).system_identifier = ak.string_new()
        html_token_ensure_doctype_data(&this.m_current_token).missing_system_identifier = false
        return tokenizer_switch_to(this, .doctype_system_identifier_single_quoted)
    if on(current_input_character, '>'):
        log_parse_error()
        html_token_ensure_doctype_data(&this.m_current_token).force_quirks = true
        return tokenizer_switch_to_and_emit_current_token(this, .data)
    if on_eof(current_input_character):
        log_parse_error()
        html_token_ensure_doctype_data(&this.m_current_token).force_quirks = true
        ak.queue_enqueue(&this.m_queued_tokens, html_tokenizer_move_current_token(this))
        return tokenizer_emit_eof(this)
    log_parse_error()
    html_token_ensure_doctype_data(&this.m_current_token).force_quirks = true
    return tokenizer_reconsume_in(this, .bogus_doctype)

