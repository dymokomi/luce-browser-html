# 13.2.5.68 Bogus DOCTYPE state, https://html.spec.whatwg.org/multipage/parsing.html#bogus-doctype-state
func html_tokenizer_bogus_doctype_state(this: HtmlTokenizer*, current_input_character: u32?, stop_at_insertion_point: HtmlTokenizerStopAtInsertionPoint) -> TokenizerStep:
    if on(current_input_character, '>'):
        return tokenizer_switch_to_and_emit_current_token(this, .data)
    if on(current_input_character, 0):
        log_parse_error()
        return TokenizerStep.consume_next
    if on_eof(current_input_character):
        ak.queue_enqueue(&this.m_queued_tokens, html_tokenizer_move_current_token(this))
        return tokenizer_emit_eof(this)
    return TokenizerStep.consume_next
