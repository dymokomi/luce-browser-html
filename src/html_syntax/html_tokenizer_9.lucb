## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.h:146 Web::HTML::HTMLTokenizer::is_insertion_point_reached.
pub func html_tokenizer_is_insertion_point_reached(this: HtmlTokenizer*) -> bool:
    if let insertion_point = this.m_insertion_point:
        return this.m_current_offset >= insertion_point
    return false

