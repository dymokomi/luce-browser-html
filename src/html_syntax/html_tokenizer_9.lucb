## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:3008 Web::HTML::HTMLTokenizer::will_switch_to.
pub func html_tokenizer_will_switch_to(this: HtmlTokenizer*, new_state: HtmlTokenizerState):
    if tokenizer_trace_debug:
        ak.dbgln(f"[{html_tokenizer_state_name(this.m_state)}] Switch to {html_tokenizer_state_name(new_state)}")

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:3013 Web::HTML::HTMLTokenizer::will_reconsume_in.
pub func html_tokenizer_will_reconsume_in(this: HtmlTokenizer*, new_state: HtmlTokenizerState):
