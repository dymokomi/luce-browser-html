        .after_doctype_public_identifier: return "AfterDOCTYPEPublicIdentifier"
        .between_doctype_public_and_system_identifiers: return "BetweenDOCTYPEPublicAndSystemIdentifiers"
        .after_doctype_system_keyword: return "AfterDOCTYPESystemKeyword"
