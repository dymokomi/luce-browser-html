# mark: Matching and tokens =====================================================================

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:2882 Web::HTML::HTMLTokenizer::consume_next_if_match.
pub func html_tokenizer_consume_next_if_match(this: HtmlTokenizer*, string: ak.StringView, stop_at_insertion_point: HtmlTokenizerStopAtInsertionPoint, case_sensitivity: ak.CaseSensitivity = ak.CaseSensitivity.case_sensitive) -> HtmlTokenizerConsumeNextResult:
    for i in 0..<ak.string_view_length(&string):
        let maybe_code_point = html_tokenizer_peek_code_point(this, (isize)i, stop_at_insertion_point)
        if maybe_code_point == none:
            if html_tokenizer_can_run_out_of_characters(this, stop_at_insertion_point):
                return HtmlTokenizerConsumeNextResult.ran_out_of_characters
            return HtmlTokenizerConsumeNextResult.not_consumed
        let code_point = maybe_code_point else trap("unreachable")
        # FIXME: This should be more Unicode-aware.
        if case_sensitivity == ak.CaseSensitivity.case_insensitive:
            if code_point < 0x80:
                if ak.to_ascii_lowercase(code_point) != ak.to_ascii_lowercase(ak.string_view_at(&string, i)):
                    return HtmlTokenizerConsumeNextResult.not_consumed
                continue
        if code_point != (u32)ak.string_view_at(&string, i):
            return HtmlTokenizerConsumeNextResult.not_consumed
    html_tokenizer_skip(this, ak.string_view_length(&string))
    return HtmlTokenizerConsumeNextResult.consumed

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:2906 Web::HTML::HTMLTokenizer::create_new_token.
pub func html_tokenizer_create_new_token(this: HtmlTokenizer*, type_: HtmlTokenType):
    html_token_construct(&this.m_current_token, type_)

    let is_start_or_end_tag = type_ == HtmlTokenType.start_tag or type_ == HtmlTokenType.end_tag
    html_token_set_start_position(&this.m_current_token, html_tokenizer_nth_last_position(this, 1 if is_start_or_end_tag else 0))

# mark: Construction and the input stream =======================================================

# The default member initializers of HTMLTokenizer that are not zero.
func html_tokenizer_init_fields(this: HtmlTokenizer*):
    this.m_state = HtmlTokenizerState.data
    this.m_return_state = HtmlTokenizerState.data
    this.m_source = ak.string_new()
    html_token_construct(&this.m_current_token, HtmlTokenType.invalid)
    ak.string_builder_construct(&this.m_current_builder)
    this.m_named_character_reference_matcher = NamedCharacterReferenceMatcher()

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:2914 Web::HTML::HTMLTokenizer::HTMLTokenizer.
pub func html_tokenizer_construct(this: HtmlTokenizer*):
    html_tokenizer_init_fields(this)
    ak.vector_clear(&this.m_decoded_input)
    this.m_current_offset = 0
    this.m_prev_offset = 0
    ak.vector_append_t(&this.m_source_positions, HtmlTokenPosition(line = 0, column = 0))

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:2922 Web::HTML::HTMLTokenizer::HTMLTokenizer.
pub func html_tokenizer_construct_string_view(this: HtmlTokenizer*, input: ak.StringView, encoding: ak.ByteString):
    html_tokenizer_init_fields(this)
    let decoder = text_codec.decoder_for(ak.byte_string_view(&encoding)) else trap("VERIFY: decoder.has_value()")
    this.m_source = text_codec.decoder_to_utf8(decoder, input) else trap("MUST: decoder->to_utf8(input)")
    let source_bytes = ak.string_bytes_as_string_view(&this.m_source)
    ak.vector_ensure_capacity(&this.m_decoded_input, ak.string_view_length(&source_bytes))
    let code_points = ak.string_code_points(&this.m_source)
    var it = ak.utf8_view_begin(&code_points)
    while not ak.utf8_code_point_iterator_done(&it):
        ak.vector_append_t(&this.m_decoded_input, ak.utf8_code_point_iterator_deref(&it))
        discard(ak.utf8_code_point_iterator_inc(&it))
    this.m_current_offset = 0
    this.m_prev_offset = 0
    ak.vector_append_t(&this.m_source_positions, HtmlTokenPosition(line = 0, column = 0))
    this.m_input_stream_closed = true

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:2936 Web::HTML::HTMLTokenizer::parser_did_run.
pub func html_tokenizer_parser_did_run(this: HtmlTokenizer*):
    # OPTIMIZATION: If we've consumed all input and the insertion point is at the start,
    #               we can throw away the decoded input buffer to save memory.
    if this.m_current_offset > 0 and (usize)this.m_current_offset == ak.vector_size(&this.m_decoded_input) and (this.m_insertion_point == none or this.m_insertion_point == 0) and ak.vector_is_empty(&this.m_old_insertion_points):
        ak.vector_clear(&this.m_decoded_input)
        this.m_current_offset = 0
        this.m_prev_offset = 0

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:2950 Web::HTML::HTMLTokenizer::unparsed_input.
pub func html_tokenizer_unparsed_input(this: const HtmlTokenizer*) -> ak.String:
    if this.m_current_offset < 0 or (usize)this.m_current_offset >= ak.vector_size(&this.m_decoded_input):
        return ak.string_new()
    var builder = ak.string_builder_new()
    ak.string_builder_append_utf32_view(&builder, ak.utf32_view_from_span(ak.vector_span_const(&this.m_decoded_input)[(usize)this.m_current_offset..]))
    return ak.string_builder_to_string(&builder) else trap("MUST: builder.to_string()")

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:2959 Web::HTML::HTMLTokenizer::append_to_input_stream.
pub func html_tokenizer_append_to_input_stream(this: HtmlTokenizer*, input: ak.StringView):
    var view: ak.Utf8View
    ak.utf8_view_construct_string_view(&view, input)
    var it = ak.utf8_view_begin(&view)
    while not ak.utf8_code_point_iterator_done(&it):
        ak.vector_append_t(&this.m_decoded_input, ak.utf8_code_point_iterator_deref(&it))
        discard(ak.utf8_code_point_iterator_inc(&it))

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:2965 Web::HTML::HTMLTokenizer::close_input_stream.
pub func html_tokenizer_close_input_stream(this: HtmlTokenizer*):
    this.m_input_stream_closed = true

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:2970 Web::HTML::HTMLTokenizer::insert_input_at_insertion_point.
pub func html_tokenizer_insert_input_at_insertion_point(this: HtmlTokenizer*, input: ak.StringView):
    var new_decoded_input: ak.Vector[u32]
    ak.vector_ensure_capacity(&new_decoded_input, ak.vector_size(&this.m_decoded_input) + ak.string_view_length(&input))

    let insertion_point = this.m_insertion_point else trap("VERIFY: m_insertion_point.has_value()")
    let before = ak.vector_span(&this.m_decoded_input)[0..<(usize)insertion_point]
    ak.vector_append_opaque(&new_decoded_input, before.data, before.length)

    let utf8_to_insert = ak.string_from_utf8(input) else trap("MUST: String::from_utf8(input)")
    var code_points_inserted: isize = 0
    let code_points = ak.string_code_points(&utf8_to_insert)
    var it = ak.utf8_view_begin(&code_points)
    while not ak.utf8_code_point_iterator_done(&it):
        ak.vector_append_t(&new_decoded_input, ak.utf8_code_point_iterator_deref(&it))
        code_points_inserted += 1
        discard(ak.utf8_code_point_iterator_inc(&it))

    let after = ak.vector_span(&this.m_decoded_input)[(usize)insertion_point..]
    ak.vector_append_opaque(&new_decoded_input, after.data, after.length)
    this.m_decoded_input = new_decoded_input

    this.m_insertion_point = insertion_point + code_points_inserted
    for old_insertion_point in &ak.vector_span(&this.m_old_insertion_points):
        if let old = *old_insertion_point:
            if insertion_point <= old:
                *old_insertion_point = old + code_points_inserted

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:2997 Web::HTML::HTMLTokenizer::insert_eof.
pub func html_tokenizer_insert_eof(this: HtmlTokenizer*):
    html_tokenizer_close_input_stream(this)
    this.m_explicit_eof_inserted = true

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:3003 Web::HTML::HTMLTokenizer::is_eof_inserted.
pub func html_tokenizer_is_eof_inserted(this: HtmlTokenizer*) -> bool:
    return this.m_explicit_eof_inserted

