        .comment_less_than_sign: return "CommentLessThanSign"
        .comment_less_than_sign_bang: return "CommentLessThanSignBang"
        .comment_less_than_sign_bang_dash: return "CommentLessThanSignBangDash"
        .comment_less_than_sign_bang_dash_dash: return "CommentLessThanSignBangDashDash"
        .comment_end_dash: return "CommentEndDash"
        .comment_end: return "CommentEnd"
        .comment_end_bang: return "CommentEndBang"
        .doctype: return "DOCTYPE"
        .before_doctype_name: return "BeforeDOCTYPEName"
        .doctype_name: return "DOCTYPEName"
        .after_doctype_name: return "AfterDOCTYPEName"
        .after_doctype_public_keyword: return "AfterDOCTYPEPublicKeyword"
        .before_doctype_public_identifier: return "BeforeDOCTYPEPublicIdentifier"
        .doctype_public_identifier_double_quoted: return "DOCTYPEPublicIdentifierDoubleQuoted"
