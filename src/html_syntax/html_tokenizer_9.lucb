        ak.dbgln(f"[{html_tokenizer_state_name(this.m_state)}] Reconsume in {html_tokenizer_state_name(new_state)}")

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:3018 Web::HTML::HTMLTokenizer::switch_to.
pub func html_tokenizer_switch_to_html_parser(this: HtmlTokenizer*, new_state: HtmlTokenizerState):
    if tokenizer_trace_debug:
        ak.dbgln(f"[{html_tokenizer_state_name(this.m_state)}] Parser switches tokenizer state to {html_tokenizer_state_name(new_state)}")
    this.m_state = new_state

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:3024 Web::HTML::HTMLTokenizer::will_emit.
pub func html_tokenizer_will_emit(this: HtmlTokenizer*, token: HtmlToken*):
    if html_token_is_start_tag(token):
        this.m_last_emitted_start_tag_name = html_token_tag_name(token)

    let is_start_or_end_tag = html_token_type(token) == HtmlTokenType.start_tag or html_token_type(token) == HtmlTokenType.end_tag
    html_token_set_end_position(token, html_tokenizer_nth_last_position(this, 1 if is_start_or_end_tag else 0))

    if is_start_or_end_tag:
        html_token_normalize_attributes(token)

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:3036 Web::HTML::HTMLTokenizer::current_end_tag_token_is_appropriate.
pub func html_tokenizer_current_end_tag_token_is_appropriate(this: const HtmlTokenizer*) -> bool:
    assert(html_token_is_end_tag(&this.m_current_token))
    let last_emitted_start_tag_name = this.m_last_emitted_start_tag_name else return false
    let tag_name = html_token_tag_name(&this.m_current_token)
    return ak.fly_string_eq_fly_string(&tag_name, &last_emitted_start_tag_name)

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:3044 Web::HTML::HTMLTokenizer::consumed_as_part_of_an_attribute.
pub func html_tokenizer_consumed_as_part_of_an_attribute(this: const HtmlTokenizer*) -> bool:
    return this.m_return_state == HtmlTokenizerState.attribute_value_unquoted or this.m_return_state == HtmlTokenizerState.attribute_value_single_quoted or this.m_return_state == HtmlTokenizerState.attribute_value_double_quoted

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:3049 Web::HTML::HTMLTokenizer::restore_to.
pub func html_tokenizer_restore_to(this: HtmlTokenizer*, new_iterator: isize):
    let diff = this.m_current_offset - new_iterator
    if diff > 0:
        for i in 0..<diff:
            discard(i)
            if not ak.vector_is_empty(&this.m_source_positions):
                discard(ak.vector_take_last(&this.m_source_positions))
    else:
        # Going forwards...?
        trap("TODO")
    this.m_current_offset = new_iterator

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:3064 Web::HTML::HTMLTokenizer::consume_current_builder.
pub func html_tokenizer_consume_current_builder(this: HtmlTokenizer*) -> ak.String:
    let string = ak.string_builder_to_string_without_validation(&this.m_current_builder)
    ak.string_builder_clear(&this.m_current_builder)
    return string

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp:3071 Web::HTML::HTMLTokenizer::visit_edges.
## visitor.visit(m_parser) is dropped (DESIGN.md §4.1.3): the parser owns the tokenizer, and
## m_parser_context is a pointer the parser keeps alive.
pub func html_tokenizer_visit_edges(this: HtmlTokenizer*, visitor: gc.CellVisitor*):
    return
