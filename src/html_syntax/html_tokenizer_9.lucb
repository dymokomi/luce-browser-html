#==============================================================================================
#
#   html_tokenizer_9 - HTMLTokenizer: construction, the input stream API and helpers
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/Parser/HTMLTokenizer.cpp (lines 2881-3076) and the inline
#       members of HTMLTokenizer.h (lines 106-237), in the header's order first.
#
#       HTMLTokenizer::m_parser (GC::Ptr<HTMLParser>) is the hook of DESIGN.md §4.1.3: the
#       parser installs m_adjusted_current_node_is_foreign and m_parser_context with
#       html_tokenizer_set_parser, and the markup declaration open state asks the hook whether
#       the adjusted current node is outside the HTML namespace.
#
#==============================================================================================

# mark: HTMLTokenizer.h =========================================================================

## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.h:123 Web::HTML::HTMLTokenizer::set_parser.
## Retyped by DESIGN.md §4.1.3: HTMLParser passes itself as `parser` and a function whose
## `adjusted_current_node_is_foreign(parser)` answers `parser.adjusted_current_node() &&
## parser.adjusted_current_node()->namespace_uri() != Namespace::HTML`.
pub func html_tokenizer_set_parser(this: HtmlTokenizer*, adjusted_current_node_is_foreign: func(void*) -> bool, parser: void*):
    this.m_adjusted_current_node_is_foreign = adjusted_current_node_is_foreign
    this.m_parser_context = parser

# `m_parser != nullptr && m_parser->adjusted_current_node() && m_parser->adjusted_current_node()->namespace_uri() != Namespace::HTML`
func html_tokenizer_adjusted_current_node_is_foreign(this: const HtmlTokenizer*) -> bool:
    let hook = this.m_adjusted_current_node_is_foreign else return false
    let parser = this.m_parser_context else return false
    return hook(parser)

