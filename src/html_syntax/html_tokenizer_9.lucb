## Ported from Libraries/LibWeb/HTML/Parser/HTMLTokenizer.h:177 Web::HTML::HTMLTokenizer::state_name.
## The C++ `char const*` is the state's name as a `str`.
pub func html_tokenizer_state_name(state: HtmlTokenizerState) -> str:
    match state:
        .data: return "Data"
        .rcdata: return "RCDATA"
        .rawtext: return "RAWTEXT"
        .script_data: return "ScriptData"
        .plaintext: return "PLAINTEXT"
        .tag_open: return "TagOpen"
        .end_tag_open: return "EndTagOpen"
        .tag_name: return "TagName"
        .rcdata_less_than_sign: return "RCDATALessThanSign"
        .rcdata_end_tag_open: return "RCDATAEndTagOpen"
        .rcdata_end_tag_name: return "RCDATAEndTagName"
        .rawtext_less_than_sign: return "RAWTEXTLessThanSign"
        .rawtext_end_tag_open: return "RAWTEXTEndTagOpen"
        .rawtext_end_tag_name: return "RAWTEXTEndTagName"
        .script_data_less_than_sign: return "ScriptDataLessThanSign"
        .script_data_end_tag_open: return "ScriptDataEndTagOpen"
        .script_data_end_tag_name: return "ScriptDataEndTagName"
        .script_data_escape_start: return "ScriptDataEscapeStart"
        .script_data_escape_start_dash: return "ScriptDataEscapeStartDash"
        .script_data_escaped: return "ScriptDataEscaped"
        .script_data_escaped_dash: return "ScriptDataEscapedDash"
        .script_data_escaped_dash_dash: return "ScriptDataEscapedDashDash"
        .script_data_escaped_less_than_sign: return "ScriptDataEscapedLessThanSign"
        .script_data_escaped_end_tag_open: return "ScriptDataEscapedEndTagOpen"
        .script_data_escaped_end_tag_name: return "ScriptDataEscapedEndTagName"
        .script_data_double_escape_start: return "ScriptDataDoubleEscapeStart"
        .script_data_double_escaped: return "ScriptDataDoubleEscaped"
        .script_data_double_escaped_dash: return "ScriptDataDoubleEscapedDash"
        .script_data_double_escaped_dash_dash: return "ScriptDataDoubleEscapedDashDash"
        .script_data_double_escaped_less_than_sign: return "ScriptDataDoubleEscapedLessThanSign"
        .script_data_double_escape_end: return "ScriptDataDoubleEscapeEnd"
        .before_attribute_name: return "BeforeAttributeName"
        .attribute_name: return "AttributeName"
        .after_attribute_name: return "AfterAttributeName"
        .before_attribute_value: return "BeforeAttributeValue"
        .attribute_value_double_quoted: return "AttributeValueDoubleQuoted"
        .attribute_value_single_quoted: return "AttributeValueSingleQuoted"
        .attribute_value_unquoted: return "AttributeValueUnquoted"
        .after_attribute_value_quoted: return "AfterAttributeValueQuoted"
        .self_closing_start_tag: return "SelfClosingStartTag"
        .bogus_comment: return "BogusComment"
        .markup_declaration_open: return "MarkupDeclarationOpen"
        .comment_start: return "CommentStart"
        .comment_start_dash: return "CommentStartDash"
