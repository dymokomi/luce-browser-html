        check_matcher("fjlig;", """
            66 consumed=1 overconsumed=1 semicolon=0 match=none
            6a consumed=1 overconsumed=2 semicolon=0 match=none
            6c consumed=1 overconsumed=3 semicolon=0 match=none
            69 consumed=1 overconsumed=4 semicolon=0 match=none
