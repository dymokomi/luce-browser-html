## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:335 Web::HTML::HTMLToken::tag_attributes.
pub func html_token_tag_attributes_const(this: const HtmlToken*) -> const ak.Vector[HtmlTokenAttribute]*?:
    match this.m_data:
        .vector_html_token_attribute(value): return value
        _: trap("Variant::get<OwnPtr<Vector<Attribute>>>: another alternative is held")

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:340 Web::HTML::HTMLToken::tag_attributes.
pub func html_token_tag_attributes(this: HtmlToken*) -> ak.Vector[HtmlTokenAttribute]*?:
    match this.m_data:
        .vector_html_token_attribute(value): return value
        _: trap("Variant::get<OwnPtr<Vector<Attribute>>>: another alternative is held")

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:345 Web::HTML::HTMLToken::ensure_tag_attributes.
pub func html_token_ensure_tag_attributes(this: HtmlToken*) -> ak.Vector[HtmlTokenAttribute]*:
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    match this.m_data:
        .vector_html_token_attribute(value):
            if let ptr = value:
                return ptr
            # make<Vector<Attribute>>()
            let ptr = new ak.Vector[HtmlTokenAttribute] else trap("out of memory")
            this.m_data = .vector_html_token_attribute(value = ptr)
            return ptr
        _: trap("Variant::get<OwnPtr<Vector<Attribute>>>: another alternative is held")
