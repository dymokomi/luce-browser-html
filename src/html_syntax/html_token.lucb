## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:177 Web::HTML::HTMLToken::acknowledge_self_closing_flag_if_set.
pub func html_token_acknowledge_self_closing_flag_if_set(this: HtmlToken*):
