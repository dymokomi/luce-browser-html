        this.m_tag_self_closing_acknowledged = true

# mark: Attributes ==============================================================================

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:183 Web::HTML::HTMLToken::has_attributes.
pub func html_token_has_attributes(this: const HtmlToken*) -> bool:
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    let ptr = html_token_tag_attributes_const(this)
    if let attributes = ptr:
        return not ak.vector_is_empty(attributes)
    return false

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:190 Web::HTML::HTMLToken::attribute_count.
pub func html_token_attribute_count(this: const HtmlToken*) -> usize:
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    if let ptr = html_token_tag_attributes_const(this):
        return ak.vector_size(ptr)
    return 0

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:198 Web::HTML::HTMLToken::add_attribute.
pub func html_token_add_attribute(this: HtmlToken*, attribute: HtmlTokenAttribute):
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    ak.vector_append_t(html_token_ensure_tag_attributes(this), attribute)

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:204 Web::HTML::HTMLToken::last_attribute.
pub func html_token_last_attribute_const(this: const HtmlToken*) -> const HtmlTokenAttribute*:
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    assert(html_token_has_attributes(this))
    let attributes = html_token_tag_attributes_const(this) else trap("VERIFY: has_attributes()")
    return ak.vector_last_const(attributes)

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:211 Web::HTML::HTMLToken::last_attribute.
pub func html_token_last_attribute(this: HtmlToken*) -> HtmlTokenAttribute*:
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    assert(html_token_has_attributes(this))
    let attributes = html_token_tag_attributes(this) else trap("VERIFY: has_attributes()")
    return ak.vector_last(attributes)

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:218 Web::HTML::HTMLToken::drop_attributes.
pub func html_token_drop_attributes(this: HtmlToken*):
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    # m_data.get<OwnPtr<Vector<Attribute>>>().clear(): the OwnPtr lets go of the Vector.
    match this.m_data:
        .vector_html_token_attribute(_): this.m_data = .vector_html_token_attribute(value = none)
        _: trap("Variant::get<OwnPtr<Vector<Attribute>>>: another alternative is held")

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:224 Web::HTML::HTMLToken::for_each_attribute.
pub func html_token_for_each_attribute_const(this: const HtmlToken*, callback: ak.Function1[const HtmlTokenAttribute*, ak.IterationDecision]):
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    let ptr = html_token_tag_attributes_const(this) else return
    for attribute in ak.vector_span_const(ptr):
        if ak.function1_call(&callback, &attribute) == ak.IterationDecision.break_:
            break

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:236 Web::HTML::HTMLToken::for_each_attribute.
pub func html_token_for_each_attribute(this: HtmlToken*, callback: ak.Function1[HtmlTokenAttribute*, ak.IterationDecision]):
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    let ptr = html_token_tag_attributes(this) else return
    for attribute in &ak.vector_span(ptr):
        if ak.function1_call(&callback, attribute) == ak.IterationDecision.break_:
            break

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:248 Web::HTML::HTMLToken::attribute.
pub func html_token_attribute(this: const HtmlToken*, attribute_name: ak.FlyString) -> ak.String?:
    if let result = html_token_raw_attribute(this, attribute_name):
        return result.value
    return none

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:255 Web::HTML::HTMLToken::raw_attribute.
pub func html_token_raw_attribute(this: const HtmlToken*, attribute_name: ak.FlyString) -> const HtmlTokenAttribute*?:
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))

    let ptr = html_token_tag_attributes_const(this) else return none
    for attribute in &ak.vector_span_const(ptr):
        if ak.fly_string_eq_fly_string(&attribute_name, &attribute.local_name):
            return attribute
    return none

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:269 Web::HTML::HTMLToken::has_attribute.
pub func html_token_has_attribute(this: const HtmlToken*, attribute_name: ak.FlyString) -> bool:
    return html_token_attribute(this, attribute_name) != none

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:274 Web::HTML::HTMLToken::adjust_tag_name.
pub func html_token_adjust_tag_name(this: HtmlToken*, old_name: ak.FlyString, new_name: ak.FlyString):
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    let tag_name = html_token_tag_name(this)
    if ak.fly_string_eq_fly_string(&old_name, &tag_name):
        html_token_set_tag_name(this, new_name)

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:281 Web::HTML::HTMLToken::adjust_attribute_name.
pub func html_token_adjust_attribute_name(this: HtmlToken*, old_name: ak.FlyString, new_name: ak.FlyString):
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    # for_each_attribute([&](Attribute& attribute) { ...; return IterationDecision::Continue; })
    let ptr = html_token_tag_attributes(this) else return
    for attribute in &ak.vector_span(ptr):
        if ak.fly_string_eq_fly_string(&old_name, &attribute.local_name):
            attribute.local_name = new_name

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:291 Web::HTML::HTMLToken::adjust_foreign_attribute.
pub func html_token_adjust_foreign_attribute(this: HtmlToken*, old_name: ak.FlyString, prefix: ak.FlyString?, local_name: ak.FlyString, namespace_: ak.FlyString?):
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    # for_each_attribute([&](Attribute& attribute) { ...; return IterationDecision::Continue; })
    let ptr = html_token_tag_attributes(this) else return
    for attribute in &ak.vector_span(ptr):
        if ak.fly_string_eq_fly_string(&old_name, &attribute.local_name):
            attribute.prefix = prefix
            attribute.local_name = local_name
            attribute.namespace_ = namespace_

# mark: DOCTYPE data ============================================================================

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:304 Web::HTML::HTMLToken::doctype_data.
pub func html_token_doctype_data(this: const HtmlToken*) -> const HtmlTokenDoctypeData*:
    assert(html_token_is_doctype(this))
    match this.m_data:
        .html_token_doctype_data(value):
            return value else trap("VERIFY: ptr")
        _: trap("Variant::get<OwnPtr<DoctypeData>>: another alternative is held")

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:312 Web::HTML::HTMLToken::ensure_doctype_data.
pub func html_token_ensure_doctype_data(this: HtmlToken*) -> HtmlTokenDoctypeData*:
    assert(html_token_is_doctype(this))
    match this.m_data:
        .html_token_doctype_data(value):
            if let ptr = value:
                return ptr
            # make<DoctypeData>(), with DoctypeData's default member initializers.
            let ptr = new HtmlTokenDoctypeData(name = ak.string_new(), public_identifier = ak.string_new(),
                                               system_identifier = ak.string_new(), missing_name = true, missing_public_identifier = true,
                                               missing_system_identifier = true, force_quirks = false) else trap("out of memory")
            this.m_data = .html_token_doctype_data(value = ptr)
            return ptr
        _: trap("Variant::get<OwnPtr<DoctypeData>>: another alternative is held")

# mark: Type, text and positions ================================================================

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:321 Web::HTML::HTMLToken::type.
pub func html_token_type(this: const HtmlToken*) -> HtmlTokenType:
    return this.m_type

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.cpp:12 Web::HTML::HTMLToken::to_string.
pub func html_token_to_string(this: const HtmlToken*) -> ak.String:
    var builder = ak.string_builder_new()

    match html_token_type(this):
        .doctype:
            ak.string_builder_append(&builder, "DOCTYPE")
            ak.string_builder_append(&builder, " { name: '")
            ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&html_token_doctype_data(this).name))
            ak.string_builder_append(&builder, "' }")
        .start_tag:
            ak.string_builder_append(&builder, "StartTag")
        .end_tag:
            ak.string_builder_append(&builder, "EndTag")
        .comment:
            ak.string_builder_append(&builder, "Comment")
        .character:
            ak.string_builder_append(&builder, "Character")
        .end_of_file:
            ak.string_builder_append(&builder, "EndOfFile")
        .invalid:
            trap("VERIFY_NOT_REACHED")
        _:
            _ = 0

    if html_token_type(this) == HtmlTokenType.start_tag or html_token_type(this) == HtmlTokenType.end_tag:
        ak.string_builder_append(&builder, " { name: '")
        let tag_name = html_token_tag_name(this)
        ak.string_builder_append_string_view(&builder, ak.fly_string_bytes_as_string_view(&tag_name))
        ak.string_builder_append(&builder, "', { ")
        # for_each_attribute([&](auto& attribute) { ...; return IterationDecision::Continue; })
        if let attributes = html_token_tag_attributes_const(this):
            for attribute in &ak.vector_span_const(attributes):
                ak.string_builder_append_string_view(&builder, ak.fly_string_bytes_as_string_view(&attribute.local_name))
                ak.string_builder_append(&builder, "=\"")
                ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&attribute.value))
                ak.string_builder_append(&builder, "\" ")
        ak.string_builder_append(&builder, "} }")

    if html_token_is_comment(this):
        ak.string_builder_append(&builder, " { data: '")
        let comment = html_token_comment(this)
        ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&comment))
        ak.string_builder_append(&builder, "' }")

    if html_token_is_character(this):
        ak.string_builder_append(&builder, " { data: '")
        ak.string_builder_append_code_point(&builder, html_token_code_point(this))
        ak.string_builder_append(&builder, "' }")

    # builder.appendff("@{}:{}", ...): AK's "{}" of a size_t is its decimal digits.
    var buffer: u8[96]
    if html_token_type(this) == HtmlTokenType.character:
        let text = strings.format(buffer, f"@{this.m_start_position.line}:{this.m_start_position.column}") else trap("MUST: appendff")
        ak.string_builder_append(&builder, text)
    else:
        let text = strings.format(buffer, f"@{this.m_start_position.line}:{this.m_start_position.column}-{this.m_end_position.line}:{this.m_end_position.column}") else trap("MUST: appendff")
        ak.string_builder_append(&builder, text)

    return ak.string_builder_to_string(&builder) else trap("MUST: builder.to_string()")

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:325 Web::HTML::HTMLToken::start_position.
pub func html_token_start_position(this: const HtmlToken*) -> HtmlTokenPosition:
    return this.m_start_position

