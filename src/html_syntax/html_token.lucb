pub func html_token_tag_name(this: const HtmlToken*) -> ak.FlyString:
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    return this.m_string_data

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:153 Web::HTML::HTMLToken::set_tag_name.
pub func html_token_set_tag_name(this: HtmlToken*, name: ak.FlyString):
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    this.m_string_data = name

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:159 Web::HTML::HTMLToken::is_self_closing.
pub func html_token_is_self_closing(this: const HtmlToken*) -> bool:
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    return this.m_tag_self_closing

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:165 Web::HTML::HTMLToken::set_self_closing.
pub func html_token_set_self_closing(this: HtmlToken*, self_closing: bool):
    assert(html_token_is_start_tag(this) or html_token_is_end_tag(this))
    this.m_tag_self_closing = self_closing

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:171 Web::HTML::HTMLToken::has_acknowledged_self_closing_flag.
pub func html_token_has_acknowledged_self_closing_flag(this: const HtmlToken*) -> bool:
