# mark: Character and comment data ==============================================================

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:106 Web::HTML::HTMLToken::code_point.
pub func html_token_code_point(this: const HtmlToken*) -> u32:
    assert(html_token_is_character(this))
    match this.m_data:
        .u32_(value): return value
        _: trap("Variant::get<u32>: another alternative is held")

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:112 Web::HTML::HTMLToken::is_parser_whitespace.
pub func html_token_is_parser_whitespace(this: const HtmlToken*) -> bool:
    # NOTE: The parser considers '\r' to be whitespace, while the tokenizer does not.
    if not html_token_is_character(this):
        return false
    match html_token_code_point(this):
        0x09, 0x0A, 0x0C, 0x0D, 0x20: return true
        _: return false

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:129 Web::HTML::HTMLToken::set_code_point.
pub func html_token_set_code_point(this: HtmlToken*, code_point: u32):
    assert(html_token_is_character(this))
    match this.m_data:
        .u32_(_): this.m_data = .u32_(value = code_point)
        _: trap("Variant::get<u32>: another alternative is held")

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:135 Web::HTML::HTMLToken::comment.
pub func html_token_comment(this: const HtmlToken*) -> ak.String:
    assert(html_token_is_comment(this))
    return this.m_comment_data

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:141 Web::HTML::HTMLToken::set_comment.
pub func html_token_set_comment(this: HtmlToken*, comment: ak.String):
    assert(html_token_is_comment(this))
    this.m_comment_data = comment

