#==============================================================================================
#
#   html_token - HTMLToken: the tokens the HTML tokenizer emits
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/Parser/HTMLToken.h (lines 1-393) and HTMLToken.cpp (lines
#       1-106). The header's inline functions come first, in the header's order, then the two
#       functions of the .cpp at the header's declaration points.
#
#       HTMLToken is move-only in C++; a Luce copy shares the attribute list and the DOCTYPE
#       data (DESIGN.md §3.3 rule 1: moves are copies). `Optional<HTMLToken>`, a
#       SentinelOptional over Type::Invalid in AK, is `HtmlToken?`.
#
#       m_data is Variant<Empty, u32, OwnPtr<DoctypeData>, OwnPtr<Vector<Attribute>>>; its get<T>
#       is a match that traps on another alternative, as AK's VERIFY does.
#
#==============================================================================================

# mark: Construction ============================================================================

import strings

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:64 Web::HTML::HTMLToken::make_character.
pub func html_token_make_character(code_point: u32) -> HtmlToken:
    var token: HtmlToken
    html_token_construct(&token, HtmlTokenType.character)
    html_token_set_code_point(&token, code_point)
    return token

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:71 Web::HTML::HTMLToken::make_start_tag.
pub func html_token_make_start_tag(tag_name: ak.FlyString) -> HtmlToken:
    var token: HtmlToken
    html_token_construct(&token, HtmlTokenType.start_tag)
    html_token_set_tag_name(&token, tag_name)
    return token

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:80 Web::HTML::HTMLToken::HTMLToken.
## With `.invalid` it is also `HTMLToken() = default`.
pub func html_token_construct(this: HtmlToken*, type_: HtmlTokenType):
    # The default member initializers.
    this.m_tag_self_closing = false
    this.m_tag_self_closing_acknowledged = false
    this.m_had_duplicate_attribute = false
    this.m_string_data = ak.fly_string_new()
    this.m_comment_data = ak.string_new()
    this.m_data = EmptyOrU32OrHtmlTokenDoctypeDataOrVectorHtmlTokenAttribute.empty
    this.m_start_position = HtmlTokenPosition()
    this.m_end_position = HtmlTokenPosition()

    this.m_type = type_
    match this.m_type:
        .character:
            this.m_data = .u32_(value = 0)
        .doctype:
            this.m_data = .html_token_doctype_data(value = none)
        .start_tag, .end_tag:
            this.m_data = .vector_html_token_attribute(value = none)
        _:
            return

## HTMLToken::Attribute {}: an attribute with the default member values (no prefix or
## namespace, an empty name and value, zero positions).
pub func html_token_attribute_new() -> HtmlTokenAttribute:
    return HtmlTokenAttribute(prefix = none, local_name = ak.fly_string_new(), namespace_ = none, value = ak.string_new())

# mark: Type queries ============================================================================

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:99 Web::HTML::HTMLToken::is_doctype.
pub func html_token_is_doctype(this: const HtmlToken*) -> bool:
    return this.m_type == HtmlTokenType.doctype

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:100 Web::HTML::HTMLToken::is_start_tag.
pub func html_token_is_start_tag(this: const HtmlToken*) -> bool:
    return this.m_type == HtmlTokenType.start_tag

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:101 Web::HTML::HTMLToken::is_end_tag.
pub func html_token_is_end_tag(this: const HtmlToken*) -> bool:
    return this.m_type == HtmlTokenType.end_tag

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:102 Web::HTML::HTMLToken::is_comment.
pub func html_token_is_comment(this: const HtmlToken*) -> bool:
    return this.m_type == HtmlTokenType.comment

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:103 Web::HTML::HTMLToken::is_character.
pub func html_token_is_character(this: const HtmlToken*) -> bool:
    return this.m_type == HtmlTokenType.character

## Ported from Libraries/LibWeb/HTML/Parser/HTMLToken.h:104 Web::HTML::HTMLToken::is_end_of_file.
pub func html_token_is_end_of_file(this: const HtmlToken*) -> bool:
