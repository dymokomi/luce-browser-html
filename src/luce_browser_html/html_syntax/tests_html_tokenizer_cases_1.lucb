                   "EOF @0:8-0:8\n")
        # from the data state
        check_case("<a b/", -1,
                   "EOF @0:5-0:5\n")
        # from the data state
        check_case("<a b=\"c\"d>", -1,
                   "StartTag a self_closing=0 dup=0 attributes=2 [b=c 0:3-0:4 0:5-0:8] [d= 0:8-0:9 0:0-0:0] @0:1-0:9\nEOF @0:10-0:10\n")
        # from the data state
