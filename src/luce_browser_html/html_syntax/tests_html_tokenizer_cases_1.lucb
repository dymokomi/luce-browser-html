#==============================================================================================
#
#   tests_html_tokenizer_cases_1 - token dumps pinned to the donor (part 1 of 2)
#
#   DESCRIPTION:
#       Cases for every tokenizer state, with the expected tokens printed by the donor's
#       HTMLTokenizer (reference build, Ladybird 47c82b38d0) through a local oracle
#       (.donors/luce-browser-tools/html_tokenizer_oracle). check_case is in
#       tests_html_tokenizer_cases_1. Generated from the oracle's output; regenerate rather
#       than edit.
#
#==============================================================================================

# mark: The dump ================================================================================

# The oracle's escape_into: \n, \r, \t, \0 and \\ spelled out, every other byte as it is.
func dump_escaped(builder: ak.StringBuilder*, view: ak.StringView):
    for byte in ak.string_view_bytes(&view):
        if byte == '\n':
            ak.string_builder_append(builder, "\\n")
        elif byte == '\r':
            ak.string_builder_append(builder, "\\r")
        elif byte == '\t':
            ak.string_builder_append(builder, "\\t")
        elif byte == 0:
            ak.string_builder_append(builder, "\\0")
        elif byte == '\\':
            ak.string_builder_append(builder, "\\\\")
        else:
            ak.string_builder_append_u8(builder, byte)

func dump_escaped_string(builder: ak.StringBuilder*, string: ak.String):
    dump_escaped(builder, ak.string_bytes_as_string_view(&string))

func dump_escaped_fly_string(builder: ak.StringBuilder*, string: ak.FlyString):
    dump_escaped(builder, ak.fly_string_bytes_as_string_view(&string))

# appendff("{}:{}", position.line, position.column)
func dump_position(builder: ak.StringBuilder*, position: HtmlTokenPosition):
    var buffer: u8[48]
    ak.string_builder_append(builder, format(buffer, f"{position.line}:{position.column}") else trap("format"))

# appendff("U+{:04X}", code_point)
func dump_code_point(builder: ak.StringBuilder*, code_point: u32):
    let digits = "0123456789ABCDEF".bytes
    var text: u8[8]
    var count: usize = 0
    var rest = code_point
    while rest != 0 or count < 4:
        text[count] = digits[rest & 0xF]
        rest = rest >> 4
        count += 1
    ak.string_builder_append(builder, "U+")
    while count > 0:
        count -= 1
        ak.string_builder_append_u8(builder, text[count])

# The for_each_attribute lambda of the oracle's dump.
func dump_attribute(context: void*?, attribute: HtmlTokenAttribute*) -> ak.IterationDecision:
    let builder = (ak.StringBuilder*)(context else trap("no captures"))
    ak.string_builder_append(builder, " [")
    dump_escaped_fly_string(builder, attribute.local_name)
    ak.string_builder_append(builder, "=")
    dump_escaped_string(builder, attribute.value)
    ak.string_builder_append(builder, " ")
    dump_position(builder, attribute.name_start_position)
    ak.string_builder_append(builder, "-")
    dump_position(builder, attribute.name_end_position)
    ak.string_builder_append(builder, " ")
    dump_position(builder, attribute.value_start_position)
    ak.string_builder_append(builder, "-")
    dump_position(builder, attribute.value_end_position)
    ak.string_builder_append(builder, "]")
    return ak.IterationDecision.continue_

# One line per token, as the oracle's dump prints it.
func dump_token(builder: ak.StringBuilder*, token: HtmlToken*):
    match html_token_type(token):
        .doctype:
            let data = html_token_doctype_data(token)
            ak.string_builder_append(builder, "DOCTYPE name=")
            if data.missing_name:
                ak.string_builder_append(builder, "<missing>")
            else:
                dump_escaped_string(builder, data.name)
            ak.string_builder_append(builder, " public=")
            if data.missing_public_identifier:
                ak.string_builder_append(builder, "<missing>")
            else:
                dump_escaped_string(builder, data.public_identifier)
            ak.string_builder_append(builder, " system=")
            if data.missing_system_identifier:
                ak.string_builder_append(builder, "<missing>")
            else:
                dump_escaped_string(builder, data.system_identifier)
            ak.string_builder_append(builder, " quirks=1" if data.force_quirks else " quirks=0")
        .start_tag, .end_tag:
            ak.string_builder_append(builder, "StartTag " if html_token_is_start_tag(token) else "EndTag ")
            dump_escaped_fly_string(builder, html_token_tag_name(token))
            var buffer: u8[96]
            ak.string_builder_append(builder, format(buffer, f" self_closing={(i32)html_token_is_self_closing(token)} dup={(i32)html_token_had_duplicate_attribute(token)} attributes={html_token_attribute_count(token)}") else trap("format"))
            html_token_for_each_attribute(token, ak.Function1[HtmlTokenAttribute*, ak.IterationDecision](call = dump_attribute, context = builder))
        .comment:
            ak.string_builder_append(builder, "Comment ")
            dump_escaped_string(builder, html_token_comment(token))
        .character:
            ak.string_builder_append(builder, "Character ")
            dump_code_point(builder, html_token_code_point(token))
        .end_of_file:
            ak.string_builder_append(builder, "EOF")
        _:
            ak.string_builder_append(builder, "Invalid")
    ak.string_builder_append(builder, " @")
    dump_position(builder, html_token_start_position(token))
    ak.string_builder_append(builder, "-")
    dump_position(builder, html_token_end_position(token))
    ak.string_builder_append(builder, "\n")

# The oracle's run: tokenize `input` as UTF-8, switch to `state` (unless -1) after the first
# token, stop after the EOF token, and compare the dump with `expected`.
func check_case(input: str, state: i32, expected: str):
    var tokenizer: HtmlTokenizer
    html_tokenizer_construct_string_view(&tokenizer, ak.sv(input), ak.byte_string_from_str("UTF-8"))
    var builder = ak.string_builder_new()
    var first = true
    while true:
        var token = html_tokenizer_next_token(&tokenizer) else break
        dump_token(&builder, &token)
        if html_token_is_end_of_file(&token):
            break
        if first and state != -1:
            html_tokenizer_switch_to_html_tokenizer_state(&tokenizer, (HtmlTokenizerState)state)
        first = false
    let actual = ak.string_builder_string_view(&builder)
    if not ak.string_view_equals(&actual, expected):
        print(f"input:    {input}")
        print(f"expected: {expected}")
        print(f"actual:   {(str)ak.string_view_bytes(&actual)}")
        trap("the tokens differ from the donor's")

# mark: DOCTYPE =================================================================================

test "cases_doctype_1":
    with memory.heap:
        # from the data state
        check_case("<!DOCTYPE html>", -1,
                   "DOCTYPE name=html public=<missing> system=<missing> quirks=0 @0:11-0:15\nEOF @0:15-0:15\n")
        # from the data state
        check_case("<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">", -1,
                   "DOCTYPE name=html public=-//W3C//DTD XHTML 1.0 Strict//EN system=http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd quirks=0 @0:11-0:109\nEOF @0:109-0:109\n")
        # from the data state
        check_case("<!doctype html system 'about:legacy-compat'>", -1,
                   "DOCTYPE name=html public=<missing> system=about:legacy-compat quirks=0 @0:11-0:44\nEOF @0:44-0:44\n")
        # from the data state
        check_case("<!DOCTYPE>", -1,
                   "DOCTYPE name=<missing> public=<missing> system=<missing> quirks=1 @0:10-0:10\nEOF @0:10-0:10\n")
        # from the data state
        check_case("<!DOCTYPE", -1,
                   "DOCTYPE name=<missing> public=<missing> system=<missing> quirks=1 @0:9-0:0\nEOF @0:9-0:9\n")
        # from the data state
        check_case("<!DOCTYPEhtml>", -1,
                   "DOCTYPE name=html public=<missing> system=<missing> quirks=0 @0:10-0:14\nEOF @0:14-0:14\n")
        # from the data state
        check_case("<!DOCTYPE html PUBLIC>", -1,
                   "DOCTYPE name=html public=<missing> system=<missing> quirks=1 @0:11-0:22\nEOF @0:22-0:22\n")
        # from the data state
        check_case("<!DOCTYPE html PUBLIC\"x\"'y'>", -1,
                   "DOCTYPE name=html public=x system=y quirks=0 @0:11-0:28\nEOF @0:28-0:28\n")

test "cases_doctype_2":
