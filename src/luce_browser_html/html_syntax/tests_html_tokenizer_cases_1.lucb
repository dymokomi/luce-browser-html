test "cases_comments_and_markup_declarations_3":
    with memory.heap:
        # from the data state
        check_case("<!---", -1,
                   "Comment  @0:0-0:5\nEOF @0:5-0:5\n")
        # from the data state
        check_case("<!--", -1,
                   "Comment  @0:0-0:4\nEOF @0:4-0:4\n")
        # from the data state
        check_case("<!--\0-->", -1,
                   "Comment � @0:0-0:8\nEOF @0:8-0:8\n")
        # from the data state
        check_case("<?php bogus \0 ?>", -1,
                   "Comment ?php bogus � ? @0:0-0:16\nEOF @0:16-0:16\n")
        # from the data state
        check_case("<?php", -1,
                   "Comment ?php @0:0-0:5\nEOF @0:5-0:5\n")
        # from the data state
        check_case("</>", -1,
                   "EOF @0:3-0:3\n")
        # from the data state
        check_case("</3>", -1,
                   "Comment 3 @0:3-0:4\nEOF @0:4-0:4\n")
        # from the data state
        check_case("</", -1,
                   "Character U+003C @0:0-0:0\nCharacter U+002F @0:0-0:0\nEOF @0:2-0:2\n")

test "cases_comments_and_markup_declarations_4":
