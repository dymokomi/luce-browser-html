# mark: Comments and markup declarations ========================================================

test "cases_comments_and_markup_declarations_1":
    with memory.heap:
        # from the data state
        check_case("<!---->", -1,
                   "Comment  @0:0-0:7\nEOF @0:7-0:7\n")
        # from the data state
        check_case("<!-->", -1,
                   "Comment  @0:0-0:5\nEOF @0:5-0:5\n")
        # from the data state
        check_case("<!--->", -1,
                   "Comment  @0:0-0:6\nEOF @0:6-0:6\n")
        # from the data state
        check_case("<!-- a -- b --!>", -1,
                   "Comment  a -- b  @0:0-0:16\nEOF @0:16-0:16\n")
        # from the data state
        check_case("<!--<!-- nested -->", -1,
                   "Comment <!-- nested  @0:0-0:19\nEOF @0:19-0:19\n")
        # from the data state
        check_case("<!--<!--->", -1,
                   "Comment <!- @0:0-0:10\nEOF @0:10-0:10\n")
        # from the data state
        check_case("<!--<!---->", -1,
                   "Comment <!-- @0:0-0:11\nEOF @0:11-0:11\n")
        # from the data state
        check_case("<!--<!-x-->", -1,
                   "Comment <!-x @0:0-0:11\nEOF @0:11-0:11\n")

