# mark: Character references ====================================================================

test "cases_character_references_1":
    with memory.heap:
        # from the data state
        check_case("&amp; &AMP &amp &ampx &amp=", -1,
                   "Character U+0026 @0:5-0:0\nCharacter U+0020 @0:6-0:0\nCharacter U+0026 @0:10-0:0\nCharacter U+0020 @0:11-0:0\nCharacter U+0026 @0:15-0:0\nCharacter U+0020 @0:16-0:0\nCharacter U+0026 @0:20-0:0\nCharacter U+0078 @0:21-0:0\nCharacter U+0020 @0:22-0:0\nCharacter U+0026 @0:26-0:0\nCharacter U+003D @0:27-0:0\nEOF @0:27-0:27\n")
        # from the data state
        check_case("&notin; &notindot; &notinvc;", -1,
                   "Character U+2209 @0:7-0:0\nCharacter U+0020 @0:8-0:0\nCharacter U+22F5 @0:18-0:0\nCharacter U+0338 @0:18-0:0\nCharacter U+0020 @0:19-0:0\nCharacter U+22F6 @0:28-0:0\nEOF @0:28-0:28\n")
        # from the data state
        check_case("&NotEqualTilde; &fjlig; &nGt; &acE;", -1,
                   "Character U+2242 @0:15-0:0\nCharacter U+0338 @0:15-0:0\nCharacter U+0020 @0:16-0:0\nCharacter U+0066 @0:23-0:0\nCharacter U+006A @0:23-0:0\nCharacter U+0020 @0:24-0:0\nCharacter U+226B @0:29-0:0\nCharacter U+20D2 @0:29-0:0\nCharacter U+0020 @0:30-0:0\nCharacter U+223E @0:35-0:0\nCharacter U+0333 @0:35-0:0\nEOF @0:35-0:35\n")
