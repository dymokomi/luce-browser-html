                   "EndTag a self_closing=0 dup=0 attributes=1 [b=c 0:4-0:5 0:6-0:7] @0:2-0:7\nEOF @0:8-0:8\n")
        # from the data state
        check_case("</A>", -1,
                   "EndTag a self_closing=0 dup=0 attributes=0 @0:2-0:3\nEOF @0:4-0:4\n")
        # from the data state
        check_case("< p>", -1,
                   "Character U+003C @0:0-0:0\nCharacter U+0020 @0:2-0:0\nCharacter U+0070 @0:3-0:0\nCharacter U+003E @0:4-0:0\nEOF @0:4-0:4\n")
        # from the data state
        check_case("<3", -1,
                   "Character U+003C @0:0-0:0\nCharacter U+0033 @0:2-0:0\nEOF @0:2-0:2\n")

