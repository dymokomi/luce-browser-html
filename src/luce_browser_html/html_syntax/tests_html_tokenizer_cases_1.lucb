test "cases_character_references_2":
    with memory.heap:
        # from the data state
        check_case("&#xFDD0; &#xFFFE; &#x1FFFF; &#x7F; &#x0B;", -1,
                   "Character U+FDD0 @0:8-0:0\nCharacter U+0020 @0:9-0:0\nCharacter U+FFFE @0:17-0:0\nCharacter U+0020 @0:18-0:0\nCharacter U+1FFFF @0:27-0:0\nCharacter U+0020 @0:28-0:0\nCharacter U+007F @0:34-0:0\nCharacter U+0020 @0:35-0:0\nCharacter U+000B @0:41-0:0\nEOF @0:41-0:41\n")
        # from the data state
        check_case("<a href=\"?a=1&amp=2&amp;b&copy=3&copy;&copyx&copy\">", -1,
                   "StartTag a self_closing=0 dup=0 attributes=1 [href=?a=1&amp=2&b&copy=3©&copyx© 0:3-0:7 0:8-0:50] @0:1-0:50\nEOF @0:51-0:51\n")
        # from the data state
        check_case("<a x=&notit; y=&amp z='&amp' w=\"&#65;&#x42&q;\">", -1,
                   "StartTag a self_closing=0 dup=0 attributes=4 [x=&notit; 0:3-0:4 0:5-0:10] [y=& 0:11-0:12 0:13-0:17] [z=& 0:18-0:19 0:20-0:26] [w=AB&q; 0:27-0:28 0:29-0:44] @0:1-0:44\nEOF @0:45-0:45\n")
        # from the data state
        check_case("<a x=\"&\" y=& z='&#'>", -1,
                   "StartTag a self_closing=0 dup=0 attributes=3 [x=& 0:3-0:4 0:5-0:8] [y=& 0:9-0:10 0:11-0:12] [z=&# 0:13-0:14 0:15-0:19] @0:1-0:19\nEOF @0:20-0:20\n")
        # from the data state
        check_case("&Aacute&aacute;&Aacut", -1,
                   "Character U+00C1 @0:7-0:0\nCharacter U+00E1 @0:15-0:0\nCharacter U+0026 @0:0-0:0\nCharacter U+0041 @0:0-0:0\nCharacter U+0061 @0:0-0:0\nCharacter U+0063 @0:0-0:0\nCharacter U+0075 @0:0-0:0\nCharacter U+0074 @0:0-0:0\nEOF @0:0-0:0\n")
        # from the data state
        check_case("&ThickSpace;&NotSquareSubset;&bne;", -1,
                   "Character U+205F @0:12-0:0\nCharacter U+200A @0:12-0:0\nCharacter U+228F @0:29-0:0\nCharacter U+0338 @0:29-0:0\nCharacter U+003D @0:34-0:0\nCharacter U+20E5 @0:34-0:0\nEOF @0:34-0:34\n")
