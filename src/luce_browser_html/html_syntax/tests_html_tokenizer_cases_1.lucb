        # from the data state
        check_case("<!DOCTYPE html PUBLIC 'x' \"y\" z>", -1,
                   "DOCTYPE name=html public=x system=y quirks=0 @0:11-0:32\nEOF @0:32-0:32\n")
        # from the data state
        check_case("<!DOCTYPE html public \"a>", -1,
                   "DOCTYPE name=html public=a system=<missing> quirks=1 @0:11-0:25\nEOF @0:25-0:25\n")
        # from the data state
        check_case("<!DOCTYPE html bogus>", -1,
                   "DOCTYPE name=html public=<missing> system=<missing> quirks=1 @0:11-0:21\nEOF @0:21-0:21\n")
        # from the data state
        check_case("<!DOCTYPE html SYSTEM \"a\" junk\0>", -1,
                   "DOCTYPE name=html public=<missing> system=a quirks=0 @0:11-0:32\nEOF @0:32-0:32\n")
        # from the data state
        check_case("<!DOCTYPE html SYSTEM>", -1,
                   "DOCTYPE name=html public=<missing> system=<missing> quirks=1 @0:11-0:22\nEOF @0:22-0:22\n")
        # from the data state
        check_case("<!DOCTYPE html SYSTEM\"a", -1,
                   "DOCTYPE name=html public=<missing> system= quirks=1 @0:11-0:0\nEOF @0:23-0:23\n")
        # from the data state
        check_case("<!DOCTYPE HTML\0x\0>", -1,
                   "DOCTYPE name=html�x� public=<missing> system=<missing> quirks=0 @0:11-0:18\nEOF @0:18-0:18\n")
        # from the data state
        check_case("<!DOCTYPE \0>", -1,
                   "DOCTYPE name=� public=<missing> system=<missing> quirks=0 @0:11-0:12\nEOF @0:12-0:12\n")

