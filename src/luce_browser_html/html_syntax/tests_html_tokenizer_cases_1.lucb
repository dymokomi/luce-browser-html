# mark: Tags and attributes =====================================================================

test "cases_tags_and_attributes_1":
    with memory.heap:
        # from the data state
        check_case("<a b=c d='e' f=\"g\" h>", -1,
                   "StartTag a self_closing=0 dup=0 attributes=4 [b=c 0:3-0:4 0:5-0:6] [d=e 0:7-0:8 0:9-0:12] [f=g 0:13-0:14 0:15-0:18] [h= 0:19-0:20 0:0-0:0] @0:1-0:20\nEOF @0:21-0:21\n")
        # from the data state
        check_case("<A HREF=X>", -1,
                   "StartTag a self_closing=0 dup=0 attributes=1 [href=X 0:3-0:7 0:8-0:9] @0:1-0:9\nEOF @0:10-0:10\n")
        # from the data state
        check_case("<br/>", -1,
                   "StartTag br self_closing=1 dup=0 attributes=0 @0:1-0:4\nEOF @0:5-0:5\n")
        # from the data state
        check_case("<br />", -1,
                   "StartTag br self_closing=1 dup=0 attributes=0 @0:1-0:5\nEOF @0:6-0:6\n")
        # from the data state
        check_case("<br/x>", -1,
                   "StartTag br self_closing=0 dup=0 attributes=1 [x= 0:4-0:5 0:0-0:0] @0:1-0:5\nEOF @0:6-0:6\n")
        # from the data state
        check_case("<p a=1 a=2 A=3>", -1,
                   "StartTag p self_closing=0 dup=1 attributes=1 [a=1 0:3-0:4 0:5-0:6] @0:1-0:14\nEOF @0:15-0:15\n")
        # from the data state
        check_case("<p a=\"x\"b>", -1,
                   "StartTag p self_closing=0 dup=0 attributes=2 [a=x 0:3-0:4 0:5-0:8] [b= 0:8-0:9 0:0-0:0] @0:1-0:9\nEOF @0:10-0:10\n")
        # from the data state
        check_case("<p =a>", -1,
                   "StartTag p self_closing=0 dup=0 attributes=1 [=a= 0:3-0:5 0:0-0:0] @0:1-0:5\nEOF @0:6-0:6\n")

test "cases_tags_and_attributes_2":
    with memory.heap:
        # from the data state
        check_case("<p \"a\" 'b' <c>", -1,
                   "StartTag p self_closing=0 dup=0 attributes=3 [\"a\"= 0:3-0:6 0:0-0:0] ['b'= 0:7-0:10 0:0-0:0] [<c= 0:11-0:13 0:0-0:0] @0:1-0:13\nEOF @0:14-0:14\n")
        # from the data state
        check_case("<a b=c`=d\"e'f<g>", -1,
                   "StartTag a self_closing=0 dup=0 attributes=1 [b=c`=d\"e'f<g 0:3-0:4 0:5-0:15] @0:1-0:15\nEOF @0:16-0:16\n")
        # from the data state
        check_case("<a\0b c\0=d\0 e='\0' f=\"\0\">", -1,
                   "StartTag a�b self_closing=0 dup=0 attributes=3 [c�=d� 0:5-0:7 0:8-0:10] [e=� 0:11-0:12 0:13-0:16] [f=� 0:17-0:18 0:19-0:22] @0:1-0:22\nEOF @0:23-0:23\n")
        # from the data state
        check_case("<a", -1,
                   "EOF @0:2-0:2\n")
        # from the data state
        check_case("<a b", -1,
                   "EOF @0:4-0:4\n")
        # from the data state
        check_case("<a b=", -1,
                   "EOF @0:5-0:5\n")
        # from the data state
        check_case("<a b=\"c", -1,
                   "EOF @0:7-0:7\n")
        # from the data state
        check_case("<a b='c", -1,
                   "EOF @0:7-0:7\n")

test "cases_tags_and_attributes_3":
