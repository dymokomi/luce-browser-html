# mark: Newlines and positions ==================================================================

noinline func test_cases_newlines_and_positions_1():
    # from the data state
    check_case("a\r\nb\rc\n\r\nd\r", -1,
        "Character U+0061 @0:1-0:0\nCharacter U+000A @1:0-0:0\nCharacter U+0062 @1:1-0:0\nCharacter U+000A @1:2-0:0\nCharacter U+0063 @1:3-0:0\nCharacter U+000A @2:0-0:0\nCharacter U+000A @3:0-0:0\nCharacter U+0064 @3:1-0:0\nCharacter U+000A @3:2-0:0\nEOF @3:2-3:2\n")
    # from the data state
    check_case("<p\nclass=x\r\nid='y'>\n</p\r>", -1,
        "StartTag p self_closing=0 dup=0 attributes=2 [class=x 1:0-1:5 1:6-1:7] [id=y 2:0-2:2 2:3-2:6] @0:1-2:6\nCharacter U+000A @3:0-0:0\nEndTag p self_closing=0 dup=0 attributes=0 @3:2-3:4\nEOF @3:5-3:5\n")
    # from the data state
    check_case("\r\n<a>\r\r\n", -1,
        "Character U+000A @1:0-0:0\nStartTag a self_closing=0 dup=0 attributes=0 @1:1-1:2\nCharacter U+000A @1:4-0:0\nCharacter U+000A @2:0-0:0\nEOF @2:0-2:0\n")
    # from the data state
    check_case("a\0b", -1,
        "Character U+0061 @0:1-0:0\nCharacter U+0000 @0:2-0:0\nCharacter U+0062 @0:3-0:0\nEOF @0:3-0:3\n")
    # from the data state
    check_case("é<é>&eacute;<p é=é>", -1,
        "Character U+00E9 @0:1-0:0\nCharacter U+003C @0:0-0:0\nCharacter U+00E9 @0:3-0:0\nCharacter U+003E @0:4-0:0\nCharacter U+00E9 @0:12-0:0\nStartTag p self_closing=0 dup=0 attributes=1 [é=é 0:15-0:16 0:17-0:18] @0:13-0:18\nEOF @0:19-0:19\n")
    # from the data state
    check_case("x<b>y", -1,
        "Character U+0078 @0:1-0:0\nStartTag b self_closing=0 dup=0 attributes=0 @0:2-0:3\nCharacter U+0079 @0:5-0:0\nEOF @0:5-0:5\n")

